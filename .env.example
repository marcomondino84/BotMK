# Credenciales de API BingX (Perpetual Futures / Swap)
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET_KEY=tu_secret_key_aqui

# Entorno de ejecución: True para Demo (VST), False para Real (USDT)
IS_DEMO=True
ENVIRONMENT=demo
DEFAULT_MARKET=swap

# Parámetros Cuantitativos y de Riesgo
POSITION_BALANCE_PCT=10.0
DEFAULT_RISK_RATIO=1.5
DEFAULT_SL_PCT=1.5
MAX_SIMULTANEOUS_POSITIONS=10
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_DRAWDOWN_PCT=5.0

# Apalancamientos por Clase de Activo (Fijo)
LEVERAGE_CRYPTO_MAJORS=15
LEVERAGE_CRYPTO_ALTS=8
LEVERAGE_INDICES=40
LEVERAGE_COMMODITIES=20
LEVERAGE_STOCKS=10

# Algoritmo Antiliquidación Automático Dinámico
AUTO_LEVERAGE_BY_SL=True
SAFETY_MARGIN_FACTOR=2.0
MAX_ALLOWED_LEVERAGE=200

# Notificaciones Telegram
TELEGRAM_ENABLED=True
TELEGRAM_BOT_TOKEN=tu_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id

# Notificaciones WhatsApp (CallMeBot)
WHATSAPP_ENABLED=False
WHATSAPP_PHONE=tu_numero_con_codigo_pais
WHATSAPP_APIKEY=tu_apikey_callmebot

# Servidor Web y Webhooks
HOST=127.0.0.1
PORT=8000
WEBHOOK_SECRET=token_secreto_para_tradingview
